// The stage: @start puts you in a car before the start line of the
// procedural stage (tc/gen.tc); crossing it starts the clock, the
// checkpoints along the road must be passed in order and the finish line
// stops it. The best time is kept per seed.

/** Checkpoints (vec), the start line first and the finish line last. */
declare global stPts: list;
/** Per car: the next checkpoint (0: not on a run) and the start tick. */
declare global stK: list;
declare global stT: list;
declare saved stBest: num;
/** The record holder's UUID (older records hold a name). */
declare saved stBestName: str;
/** Player data is kept by UUID (names can change); this is each UUID's
 * latest name, for showing records. */
declare saved playerName: dict[str];

/** The latest name of player `id` (a UUID); an old record's name as is. */
function playerNameOf(id: str): str {
    if (saved playerName.hasKeys(id)) {
        return saved playerName[id];
    }
    return id;
}

function stageLoad {
    if (global gnReady == 1) {
        global stPts = gnCheckpoints();
    } else {
        global stPts = mapCheckpoints();
    }
}

/** The stage's name on the HUD and in messages. */
function stageName(): str {
    if (global gnSeed > 0) {
        line seed = global gnSeed;
        return "#%var(seed)";
    }
    return "SS1";
}

/** "m:ss.s" for t seconds. */
function stageTime(t: num): str {
    line m = num.floor(t / 60);
    line s = num.floor((t - line m * 60) * 10) / 10;
    if (line s < 10) {
        return "%var(m):0%var(s)";
    }
    return "%var(m):%var(s)";
}

/** Called every tick for a driven car. */
function stageTick(c: num) {
    if (global stPts.len() < 2) {
        return;
    }
    while (global stK.len() < c) {
        global stK.append(0);
        global stT.append(0);
    }
    line p = global cPos[c] as vec;
    line k = global stK[c] as num;
    if (line k == 0) {
        line s = global stPts[1] as vec;
        if (vec(line p.x - line s.x, 0, line p.z - line s.z).len() < 5 && num.abs(line p.y - line s.y) < 4) {
            global stK[c] = 2;
            global stT[c] = global rTick;
            select playersByName(global cDriver[c]);
            selected.sendTitle(s"<green><b>GO!", s"", 20, 0, 10);
            selected.playSound(snd("Bell", 1.5, 1));
            select reset;
        }
        return;
    }
    line q = global stPts[line k] as vec;
    if (vec(line p.x - line q.x, 0, line p.z - line q.z).len() > 12) {
        return;
    }
    line t = (global rTick - (global stT[c] as num)) / 20;
    line ts = stageTime(line t);
    select playersByName(global cDriver[c]);
    if (line k < global stPts.len()) {
        global stK[c] = line k + 1;
        line cp = line k - 1;
        selected.sendTitle(s"", s"<yellow>Split %var(cp): %var(ts)", 30, 0, 10);
        selected.playSound(snd("Pling", 1.5, 1));
    } else {
        global stK[c] = 0;
        line name: str = "%selected";
        line who = selected.uuid;
        saved playerName[line who] = line name;
        line sn = stageName();
        allPlayers.sendMessage(s"<gold><b>Stage %var(sn)</b></gold> <white>%var(name)</white> <gray>finished in</gray> <yellow><b>%var(ts)</b></yellow>");
        if (global gnSeed > 0) {
            if (gnRecord(line who, line t) == 1) {
                allPlayers.sendMessage(s"<gold>New record for stage %var(sn)!");
            }
        } else if (saved stBest == 0 || line t < saved stBest) {
            saved stBest = line t;
            saved stBestName = line who;
            allPlayers.sendMessage(s"<gold>New stage record!");
        }
        selected.sendTitle(s"<yellow><b>%var(ts)", s"<gray>Stage time", 60, 5, 20);
        selected.playSound(snd("Challenge Complete", 1, 1));
    }
    select reset;
}

/** Stage clock text for the HUD, or "" when not on a run. */
function stageHud(c: num): str {
    if (global stK.len() < c) {
        return "";
    }
    if (global stK[c] as num == 0) {
        return "";
    }
    line t = (global rTick - (global stT[c] as num)) / 20;
    return stageTime(line t);
}

/** 1 when someone other than uuid is on a timed run. */
function stageOthersRunning(uuid: str): num {
    repeat (line c to num.min(global carCount, global stK.len())) {
        if (global stK[line c] as num != 0 && global cDriver[line c] != "" && global cDriver[line c] != uuid) {
            return 1;
        }
    }
    return 0;
}

/** @start [new | SEED]: a car before the start line of the stage, with you
 * in it. No argument: the current stage (or the last one played, or a new
 * one). "new": a new random seed. A number: that seed. A new stage can't
 * replace one someone else is driving. */
function startCommand(arg: str = "") {
    if (carOf(default.uuid) != 0) {
        exitCar();
    }
    ensureLoop();
    line want = -1;
    if (arg == "new") {
        line want = num.floor(num.randomd(1, 100000));
    } else if (arg != "") {
        line want = num.floor(num.abs(num.parse(arg)));
    } else if (global gnSeed == 0) {
        line want = saved gnLast;
        if (line want <= 0) {
            line want = num.floor(num.randomd(1, 100000));
        }
    }
    if (line want > 0 && line want != global gnSeed) {
        if (stageOthersRunning(default.uuid) == 1) {
            line cur = global gnSeed;
            default.sendMessage(s"<gray>Someone is driving stage <yellow>#%var(cur)</yellow>; <yellow>@start</yellow> joins it.");
            return;
        }
        gnNewStage(line want);
    }
    // Wait for the plan and the first stretch of road.
    line seed = global gnSeed;
    line tries = 0;
    while (global gnReady == 0 || global gnSDone < num.min(global gnPre, global gnN)) {
        if (global gnSeed != line seed || line tries > 2400) {
            default.sendMessage(s"<gray>The stage did not get ready.");
            return;
        }
        if (global gnPhase == "clearing") {
            line pct = num.floor(global gnClearDone * 100 / num.max(1, global gnClearAll));
            default.sendActionBar(s"<gray>Clearing the old stage %var(pct)%");
        } else if (global gnReady == 0) {
            line ph = global gnPhase;
            default.sendActionBar(s"<gray>Planning stage <yellow>#%var(seed)</yellow> (%var(ph))");
        } else {
            line pct = num.floor(global gnSDone * 100 / num.max(1, num.min(global gnPre, global gnN)));
            default.sendActionBar(s"<gray>Building stage <yellow>#%var(seed)</yellow> %var(pct)%");
        }
        wait(5);
        line tries += 5;
    }
    line at = gnStartLoc();
    line yaw: num = line at.getCoordinate(coord="Yaw");
    // Stand beside the spot first, so its chunks load before the car spawns.
    line side = vec(num.cos(line yaw), 0, num.sin(line yaw)) * 2;
    default.teleport(loc(line at.x + line side.x, line at.y + 0.2, line at.z + line side.z, 0, line yaw));
    default.setToAdventureMode();
    wait(10);
    line c = spawnCarFor(line at);
    enterNearestCar();
    while (global stK.len() < line c) {
        global stK.append(0);
        global stT.append(0);
    }
    global stK[line c] = 0;
    global gnCarK["%var(c)"] = 1;
    line names = gnBioNames();
    default.sendMessage(s"<gold><b>Stage #%var(seed)</b></gold> <gray>%var(names)</gray>");
    line best = gnBestText(line seed);
    if (line best != "") {
        default.sendMessage(s"<gray>Record: <yellow>%var(best)</yellow>.");
    }
}
