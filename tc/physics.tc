// Car physics: one rigid body per car, stepped once per tick (dt = 0.05 s).
//
// - Suspension: each wheel reads the smoothed ground height (ground.tc)
//   under it, where block steps are ramps. That gives the compression; a
//   spring and damper push the body up at the contact point.
// - Tires: at each contact the tire takes up the sideways slip velocity (an
//   impulse that cancels part of it per tick) and adds drive, brake and
//   rolling forces along the wheel. The sum is capped by a friction circle,
//   grip * surface * load; a capped tire slides. Under power or the handbrake
//   the rear runs out of grip first, so the car can drift.
// - Drivetrain: engine torque curve, six-speed automatic, 40/60 front/rear.
// - Body: gravity, drag and a little downforce; angular velocity is stepped
//   in the car frame with a diagonal inertia.
// - Collisions: probe points on the body corners push out of solid blocks
//   with an impulse (restitution and friction).
//
// Not modeled (CPU): wheel inertia, slip-angle curves, camber, suspension
// geometry changes, tire heat, aero balance.

/** Tunables (@tune). */
declare global tSpring: num;
declare global tDamper: num;
declare global tGrip: num;
declare global tPower: num;
declare global tBrake: num;
declare global tSteer: num;
declare global tLatGain: num;
/** Ground smoothing half-width in blocks (ground.tc). */
declare global tSmooth: num;
/** Collision probe points (car frame, relative to the center of mass). */
declare global gProbes: list[vec];
/** Grip per surface block id; blocks not listed have surfDefault. */
declare global surfMu: dict[num];
declare global surfDefault: num;
/** Last computed total force (debug). */
declare global dbgForce: vec;
/** Global tick counter. */
declare global rTick: num;

/** Default tunables. */
function resetTuning {
    // Spring: about 0.11 m static sag of the 0.24 m travel. Damper at about
    // 0.55 of critical (5150), so the body settles after a bump.
    global tSpring = 24000;
    global tDamper = 2800;
    global tGrip = 2;
    global tPower = 1.0;
    global tBrake = 15000;
    global tSteer = 32;
    // Share of the sideways slip velocity a tire takes up per tick.
    global tLatGain = 0.8;
    global tSmooth = 5;
}

/** Collision probes: the body's eight corners plus the nose and tail. */
function loadProbes {
    line com = carCom();
    global gProbes = [];
    for (line y of [0.3, 1.38]) {
        for (line x of [0.86, -0.86]) {
            for (line z of [2.0, -1.98]) {
                global gProbes.append(vec(line x, line y as num, line z as num) - line com);
            }
        }
    }
    global gProbes.append(vec(0, 0.45, 2.08) - line com);
    global gProbes.append(vec(0, 0.45, -2.04) - line com);
    global gProbes.append(vec(0, 1.41, -0.4) - line com);
    for (line x of [0.87, -0.87]) {
        global gProbes.append(vec(line x as num, 0.65, 0.3) - line com);
        global gProbes.append(vec(line x as num, 0.65, -0.9) - line com);
    }
}

/** Grip per surface. Asphalt-like blocks 1.0, gravel 0.7, grass 0.6, snow 0.4,
 * ice 0.1. */
function loadSurfaces {
    global surfDefault = 0.9;
    global surfMu = {
        stone: 1.0, smooth_stone: 1.0, andesite: 0.95, polished_andesite: 1.0, black_concrete: 1.05,
        gray_concrete: 1.05, light_gray_concrete: 1.05, cobblestone: 0.9, stone_bricks: 1.0, deepslate: 0.95,
        gravel: 0.7, coarse_dirt: 0.72, dirt: 0.75, rooted_dirt: 0.72, dirt_path: 0.8, podzol: 0.68,
        grass_block: 0.62, mycelium: 0.6, moss_block: 0.55, farmland: 0.6, clay: 0.6, mud: 0.45,
        sand: 0.5, red_sand: 0.5, soul_sand: 0.4, snow_block: 0.4, snow: 0.4, powder_snow: 0.3,
        ice: 0.12, packed_ice: 0.1, blue_ice: 0.08, andesite_slab: 0.95, smooth_stone_slab: 1.0,
        white_concrete: 1.05, black_concrete: 1.05, terracotta: 0.85, red_terracotta: 0.85,
        tuff_slab: 0.7, mud_brick_slab: 0.72, smooth_quartz_slab: 0.42, smooth_quartz: 0.42, polished_deepslate_slab: 1.05,
        spruce_planks: 0.85, orange_terracotta: 0.85, yellow_terracotta: 0.85, white_terracotta: 0.85,
        brown_terracotta: 0.85, polished_andesite_slab: 1.0, hay_block: 0.5
    };
}

/** Engine torque (N m) at rpm: 500 at 5200, falling off either side; cut
 * above 7800. */
function engineTorque(rpm: num): num {
    if (rpm > 7800) {
        return 0;
    }
    line dev = (rpm - 5200) / 3000;
    return num.max(150, 500 * (1 - 0.45 * line dev * line dev));
}

/** Gearbox mode per player uuid: 1 manual (left click up, right click
 * down), 0 or missing auto. */
declare saved gearMode: dict[num];

/** 1 when player uuid drives with the manual gearbox. */
function gearManual(uuid: str): num {
    if (uuid != "" && saved gearMode.hasKeys(uuid)) {
        return saved gearMode[uuid];
    }
    return 0;
}

/** Engine torque (N m) of car c at rpm. The hypercar's 4.0 twin-turbo V8:
 * 520 without boost, best at 4500 rpm; the turbos add up to 330 as the
 * boost builds (cBoost, 0..1), from 2000 rpm and fully above 3500. */
function engineTorqueOf(c: num, rpm: num): num {
    if (global cModel[c] != 2) {
        return engineTorque(rpm);
    }
    if (rpm > 7800) {
        return 0;
    }
    line dev = (rpm - 4500) / 3800;
    line base = num.max(220, 520 * (1 - 0.4 * line dev * line dev));
    line spool = num.clamp((rpm - 2000) / 1500, 0, 1);
    return line base + 330 * global cBoost[c] * line spool;
}

/** Traction control per player uuid: 0 off, 1 or missing on. */
declare saved tcMode: dict[num];

/** 1 when player uuid drives with traction control (the default). */
function tcOn(uuid: str): num {
    if (uuid != "" && saved tcMode.hasKeys(uuid)) {
        return saved tcMode[uuid];
    }
    return 1;
}

/** Manual gearbox: shifts the player's car up (dir 1) or down (dir -1).
 * Up from reverse goes to first; there is no neutral. */
function shiftGear(dir: num) {
    line c = carOf(default.uuid);
    if (line c == 0 || gearManual(default.uuid) == 0) {
        return;
    }
    line g = global cGear[line c];
    line top = num.min(6, global cGearMax[line c]);
    line was = line g;
    if (dir > 0) {
        if (line g == -1) {
            line g = 1;
        } else if (line g < line top) {
            line g += 1;
        }
    } else if (line g > 1) {
        line g -= 1;
    }
    if (line g != line was) {
        global cGear[line c] = line g;
        global cShift[line c] = 3;
    }
}

/** Gear ratio of gear g (-1 = reverse). */
function gearRatio(g: num): num {
    if (g == -1) {
        return 3.2;
    }
    return [3.4, 2.3, 1.75, 1.38, 1.13, 0.94][g] as num;
}

/** Steps car c by one tick. fwdIn and sideIn are the driver's W/S and A/D
 * (-1..1), hand is 1 while the handbrake is held. */
function carStep(c: num, fwdIn: num, sideIn: num, hand: num) {
    line dt = 0.05;
    line m = global gMass;
    line pos = global cPos[c];
    line vel = global cVel[c];
    line w = global cW[c];
    line L = global cL[c];
    line U = global cU[c];
    line F = global cF[c];
    line com = carCom();
    line vF = line vel.dot(line F);

    // Driver: throttle, brake and gear.
    line gear = global cGear[c];
    line throttle = 0;
    line brake = 0;
    if (fwdIn > 0.1) {
        if (line gear == -1 && line vF < -0.5) {
            line brake = 1;
        } else {
            if (line gear == -1) {
                line gear = 1;
            }
            line throttle = 1;
        }
    } else if (fwdIn < -0.1) {
        if (line gear >= 1 && line vF > 0.5) {
            line brake = 1;
        } else {
            line gear = -1;
            line throttle = 1;
        }
    }

    // Steering: less lock at speed, eased toward the target.
    line speed = num.abs(line vF);
    line lock = global tSteer / (1 + line speed * line speed / 500);
    line want = sideIn * line lock;
    line steer = global cSteer[c];
    line steer = line steer + num.clamp(line want - line steer, -5, 5);

    // Engine: rpm from road speed, plus wheelspin and launch slip.
    // Redline 7500, limiter 7800.
    line ratio = gearRatio(line gear);
    line road = line speed / global gWheelR * 9.549 * line ratio * 4.1;
    // A tire past its grip under power spins, whether it slides along the
    // wheel or sideways (a drift).
    line spinning = 0;
    repeat (line i to 4) {
        if (global wSlide[(c - 1) * 4 + line i] >= 1) {
            line spinning += 1;
        }
    }
    line rpm = line road;
    // Traction control (on unless the driver turned it off in the menu):
    // while a tire is past its grip under power, the power share drops by
    // 30% a tick (to 25% at least) and comes back 8% a tick once they grip,
    // and the revs stay with the road. The tires then keep their side grip
    // instead of spending it all on wheelspin.
    line tc = tcOn(global cDriver[c]);
    line cut = global cTc[c];
    if (line tc == 1) {
        if (line throttle > 0 && line spinning >= 1) {
            line cut = num.max(0.25, line cut * 0.7);
        } else {
            line cut = num.min(1, line cut + 0.08);
        }
    } else {
        line cut = 1;
        if (line throttle > 0 && line spinning >= 1) {
            // No traction control: spinning tires let the engine rev freely
            // into the limiter (torque cuts above 7800, so it bounces there).
            line rpm = num.max(line rpm, global cRpm[c] + (8000 - global cRpm[c]) * 0.3);
        }
    }
    global cTc[c] = line cut;
    if (line throttle > 0) {
        line rpm = num.max(line rpm, 2600);
    }
    line rpm = num.max(900, global cRpm[c] * 0.4 + line rpm * 0.6);
    // Gearbox. Auto (the default) shifts up as the engine nears the redline,
    // wheelspin included, and down when it would bog, but not while the
    // tires spin (that would hunt between gears). Manual (gearMode 1, set
    // in the menu) only shifts on the driver's clicks (shiftGear).
    line shift = global cShift[c];
    if (line shift > 0) {
        line shift -= 1;
    } else if (line gear >= 1 && gearManual(global cDriver[c]) == 0) {
        if ((line rpm > 7200 || line road > 6900) && line gear < 6) {
            line gear += 1;
            line shift = 4;
        } else if (line road < 3000 && line gear > 1 && line spinning == 0) {
            line gear -= 1;
            line shift = 3;
        }
    }
    // A damaged gearbox loses the top gears; a broken one gives no drive.
    if (line gear > global cGearMax[c]) {
        line gear = num.max(1, global cGearMax[c]);
        line ratio = gearRatio(line gear);
    }
    // Hypercar turbos: boost builds under throttle above 2000 rpm (about a
    // second to full from 3000 rpm), and a lift or a shift dumps it through
    // the blow-off valve.
    if (global cModel[c] == 2) {
        line boost = global cBoost[c];
        if (line throttle > 0 && line shift == 0 && line rpm > 2000) {
            line boost = num.min(1, line boost + 0.02 + 0.03 * line rpm / 7000);
        } else if (line boost > 0.5) {
            global cBov[c] = 1;
            line boost = line boost * 0.3;
        } else {
            line boost = num.max(0, line boost - 0.1);
        }
        global cBoost[c] = line boost;
    }
    line drive = 0;
    if (line shift == 0 && global cGearMax[c] > 0) {
        line drive = engineTorqueOf(c, line rpm) * line ratio * 4.1 * 0.85 / global gWheelR * line throttle * global tPower * global cPower[c] * line cut;
    }
    // Limiter: above 7800 the fuel is cut (no torque this tick) and the revs
    // drop, so an engine revving on spinning tires bounces off it instead
    // of staying there with no power.
    if (line rpm > 7800) {
        line rpm = 7300;
    }
    // No radiator: the engine overheats under throttle. A hurt engine smokes.
    if (global rTick % 20 == 0) {
        if (global cOverheat[c] == 1 && line throttle > 0) {
            partDamage(c, global iEngine, 6);
        }
    }
    if (global rTick % 4 == 0) {
        if (partHealth(c, global iEngine) < 0.5) {
            allPlayers.displayParticleEffect(par("Large Smoke"), partWorld(c, global iEngine));
        }
    }
    if (line gear == -1) {
        line drive = 0 - line drive * 0.6;
    }
    // Engine braking off throttle.
    if (line throttle == 0 && line gear >= 1 && line speed > 1) {
        line drive = 0 - line vF / line speed * 900 * line ratio / 3.4;
    }

    line force = vec(0, -9.81, 0);
    line torque = vec(0, 0, 0);
    line cs = num.cos(line steer);
    line sn = num.sin(line steer);
    repeat (line i to 4) {
        line out = wheelForce(c, line i, line pos, line vel, line w, line L, line U, line F, line drive, line brake, hand, line throttle, line cs, line sn);
        line force = line force + line out[1] as vec;
        line torque = line torque + line out[2] as vec;
    }

    // Drag and downforce (about 0.25 g at 30 m/s).
    line force = line force - line vel * (0.42 * line vel.len() / line m) - line U * (3.0 * line vF * line vF / line m);

    // Integrate. force and torque are per unit mass; m / I turns torque into
    // angular acceleration (inertia 1900 pitch, 2200 yaw, 550 roll kg m^2).
    global dbgForce = line force;
    line vel = line vel + line force * line dt;
    line tl = line torque.dot(line L) * line m / 1900;
    line tu = line torque.dot(line U) * line m / 2200;
    line tf = line torque.dot(line F) * line m / 550;
    line w = (line w + (line L * line tl + line U * line tu + line F * line tf) * line dt) * 0.995;
    line pos = line pos + line vel * line dt;
    // Wheels on a step: lift the body there directly and stop that point
    // sinking, with no rebound (a spring pushing the body up would launch it).
    repeat (line i to 4) {
        line e = global wExcess[(c - 1) * 4 + line i];
        if (line e > 0.005) {
            line side = 1;
            if (line i % 2 == 0) {
                line side = -1;
            }
            line z = global gAxleR;
            if (line i <= 2) {
                line z = global gAxleF;
            }
            line r = line L * (line side * global gTrackX - line com.x) + line U * (0.24 + line e - 0.12 - line com.y) + line F * (line z - line com.z);
            line vn = (line vel + line w.cross(line r)).dot(line U);
            if (line vn < 0) {
                line mi = line m / 1500;
                line rn = line r.cross(line U);
                line j = 0 - line vn / (1 + line rn.dot(line rn) * line mi);
                line vel = line vel + line U * line j;
                line w = line w + line rn * (line j * line mi);
            }
            line pos = line pos + line U * (line e * 0.5);
        }
    }
    line F = (line F + line w.cross(line F) * line dt).setLength(1);
    line U = line U + line w.cross(line U) * line dt;
    line L = line U.cross(line F).setLength(1);
    line U = line F.cross(line L);

    global cPos[c] = line pos;
    global cVel[c] = line vel;
    global cW[c] = line w;
    global cL[c] = line L;
    global cU[c] = line U;
    global cF[c] = line F;
    global cSteer[c] = line steer;
    global cGear[c] = line gear;
    global cRpm[c] = line rpm;
    global cShift[c] = line shift;
    if (line throttle > 0 && line shift == 0) {
        global cThr[c] = 1;
    } else {
        global cThr[c] = 0;
    }
    carCollide(c);
}

/** Pushes car c's body out of solid blocks: each probe point inside a block
 * is moved out through the block's nearest face, with an impulse that stops
 * the point going in (restitution 0.3) and friction along the face. */
function carCollide(c: num) {
    line m = global gMass;
    line pos = global cPos[c];
    line vel = global cVel[c];
    line w = global cW[c];
    line L = global cL[c];
    line U = global cU[c];
    line F = global cF[c];
    line impact = 0;
    line hitAt = vec(0, 0, 0);
    for (line pl of global gProbes) {
        line pv = line pl as vec;
        line r = line L * line pv.x + line U * line pv.y + line F * line pv.z;
        line p = line pos + line r;
        line blk = game.getBlockMaterial(loc(line p.x, line p.y, line p.z), returnValue="Item");
        line touching = 0;
        line n = vec(0, 1, 0);
        line depth = 0;
        if (line blk.isSolid()) {
            // A block with a solid block above it is a wall. One with open
            // space above is ground: the body rides on the smoothed ground
            // (ground.tc), so it can clip the edge of a step and slides up
            // the ramp instead of hitting the edge.
            line cy = num.floor(line p.y);
            line above = game.getBlockMaterial(loc(line p.x, line cy + 1.5, line p.z), returnValue="Item");
            if (line above.isSolid()) {
                line touching = 2;
            } else {
                line gh = groundAt(line p.x, line p.z, line p.y);
                line depth = line gh - line p.y;
                if (line gh < -900 || line depth > 0.9) {
                    line touching = 2;
                } else if (line depth > 0.005) {
                    line touching = 1;
                }
            }
        }
        if (line touching == 2) {
            // Push out through the nearest face of the block.
            line fx = line p.x - num.floor(line p.x);
            line fy = line p.y - num.floor(line p.y);
            line fz = line p.z - num.floor(line p.z);
            line n = vec(0, 1, 0);
            line depth = 1 - line fy;
            if (line fy < line depth) {
                line n = vec(0, -1, 0);
                line depth = line fy;
            }
            if (line fx < line depth) {
                line n = vec(-1, 0, 0);
                line depth = line fx;
            }
            if (1 - line fx < line depth) {
                line n = vec(1, 0, 0);
                line depth = 1 - line fx;
            }
            if (line fz < line depth) {
                line n = vec(0, 0, -1);
                line depth = line fz;
            }
            if (1 - line fz < line depth) {
                line n = vec(0, 0, 1);
                line depth = 1 - line fz;
            }
        }
        if (line touching > 0) {
            line vp = line vel + line w.cross(line r);
            line vn = line vp.dot(line n);
            if (line vn < 0) {
                // Impulses per unit mass; mi = m / I with I about 1500 kg m^2.
                line mi = line m / 1500;
                line rn = line r.cross(line n);
                line kk = 1 + line rn.dot(line rn) * line mi;
                line j = 0 - 1.3 * line vn / line kk;
                line vel = line vel + line n * line j;
                line w = line w + line rn * (line j * line mi);
                if (0 - line vn > line impact) {
                    line impact = 0 - line vn;
                    line hitAt = line pv + carCom();
                }
                line vt = line vp - line n * line vn;
                line vtl = line vt.len();
                if (line vtl > 0.01) {
                    line td = line vt * (1 / line vtl);
                    line jt = num.min(line vtl / line kk, 0.6 * line j);
                    line vel = line vel - line td * line jt;
                    line w = line w - line r.cross(line td) * (line jt * line mi);
                }
            }
            line pos = line pos + line n * (line depth * 0.8);
        }
    }

    global cPos[c] = line pos;
    global cVel[c] = line vel;
    global cW[c] = line w;
    global cImpact[c] = line impact;
    if (global cGrace[c] > 0) {
        global cGrace[c] -= 1;
    } else if (line impact > 3) {
        impactDamage(c, line hitAt, line impact);
    }
}

/** Suspension and tire force on car c's wheel i (1 front left, 2 front
 * right, 3 rear left, 4 rear right) for this tick: [force, torque about the
 * center of mass]. Updates the wheel's compression, slide flag, grip and
 * roll angle. */
function wheelForce(c: num, i: num, pos: vec, vel: vec, w: vec, L: vec, U: vec, F: vec, drive: num, brake: num, hand: num, throttle: num, cs: num, sn: num): list {
    line dt = 0.05;
    line meff = global gMass * 0.25;
    line com = carCom();
    line k = (c - 1) * 4 + i;
    if (global wGone[line k] == 1) {
        global wComp[line k] = 0;
        global wSlide[line k] = 0;
        global wExcess[line k] = 0;
        return [vec(0, 0, 0), vec(0, 0, 0)];
    }
    line side = 1;
    if (i % 2 == 0) {
        line side = -1;
    }
    line front = i <= 2;
    line z = global gAxleR;
    if (line front) {
        line z = global gAxleF;
    }
    // Ground under the wheel: the smoothed ground height (ground.tc) at the
    // wheel's bottom at mid travel (car frame y 0), as a car-frame height
    // measured along U.
    line ml = vec(line side * global gTrackX - line com.x, 0 - line com.y, line z - line com.z);
    line wp = line pos + line L * line ml.x + line U * line ml.y + line F * line ml.z;
    line ground = -9;
    if (U.y > 0.3) {
        line gh = groundAt(line wp.x, line wp.z, line wp.y);
        if (line gh > -900) {
            line ground = (line gh - line wp.y) / U.y;
        }
    }
    // Compression from full droop (wheel bottom at -0.12); 0.24 is full bump.
    if (line ground > -0.12) {
        // Past full bump (0.24) the wheel is on a step: the spring stops
        // there, and carStep lifts the body by the rest (wExcess).
        global wExcess[line k] = num.max(0, line ground + 0.12 - 0.24);
        line comp = num.min(line ground + 0.12, 0.24);
        line cl = vec(line side * global gTrackX - line com.x, line ground - line com.y, line z - line com.z);
        line hv = line pos + line L * line cl.x + line U * line cl.y + line F * line cl.z;
        line cvel = (line comp - global wComp[line k]) / line dt;
        // The damper blows off above 1.5 m/s, so a sudden step cannot kick.
        line fs = global tSpring * global wSpringF[line k] * line comp + global tDamper * num.clamp(line cvel, -1.5, 1.5);
        if (line comp > 0.21) {
            // Bump stop. Past full bump (a step) it keeps pushing the body up.
            line fs += 40000 * (line comp - 0.21);
            // Slamming into the bump stop hurts the spring and the arm.
            if (line cvel > 6 && global cGrace[c] == 0) {
                partDamage(c, [global iSpring1, global iSpring2, global iSpring3, global iSpring4][i] as num, (line cvel - 6) * 12);
                partDamage(c, [global iArm1, global iArm2, global iArm3, global iArm4][i] as num, (line cvel - 6) * 6);
            }
        }
        line fs = num.max(0, line fs);
        line r = line hv - line pos;
        line vc = line vel + line w.cross(line r);
        line fw = line F;
        if (line front) {
            line fw = line F * cs + line L * sn;
        }
        line lat = line U.cross(line fw);
        line vlong = line vc.dot(line fw);
        line vlat = line vc.dot(line lat);
        if (global rTick % 5 == 0) {
            // The block on top of the column under the wheel.
            line ct = colTop(num.floor(line wp.x), num.floor(line wp.z), num.floor(line wp.y));
            if (line ct < -900 || line ct - line wp.y > 1.25) {
                line ct = line hv.y;
            }
            line under = game.getBlockMaterial(loc(line wp.x, line ct - 0.05, line wp.z));
            if (global surfMu.hasKeys(line under)) {
                global wMu[line k] = global surfMu[line under];
            } else {
                global wMu[line k] = global surfDefault;
            }
        }
        line fmax = global wMu[line k] * global tGrip * global wGripF[line k] * line fs;
        line sgn = 1;
        if (line vlong < 0) {
            line sgn = -1;
        }
        // Sideways: take up part of the slip velocity this tick.
        line fy = 0 - line vlat * line meff / line dt * global tLatGain;
        // Along the wheel: drive (40% front, 60% rear), brakes, rolling.
        line fx = drive * 0.2 * global wDrive[line k];
        if (!line front) {
            line fx = drive * 0.3 * global wDrive[line k];
        }
        if (brake > 0) {
            line share = 0.2;
            if (line front) {
                line share = 0.3;
            }
            line fx -= line sgn * num.min(global tBrake * line share, num.abs(line vlong) * line meff / line dt);
        }
        if (hand > 0 && !line front) {
            // Locked rear wheels: they skid along and lose most side grip.
            line fx = 0 - line sgn * num.min(line fmax, num.abs(line vlong) * line meff / line dt);
            line fy = line fy * 0.3;
        }
        line fx -= line vlong * 25;
        line mag = num.root(line fx * line fx + line fy * line fy);
        line slide = 0;
        if (line mag > line fmax && line mag > 0.01) {
            // 1: spinning or locked (mostly along the wheel), 2: sliding sideways.
            line slide = 2;
            if (num.abs(line fx) > num.abs(line fy)) {
                line slide = 1;
            }
            line fm = line fmax * 0.9;
            // A driven tire spinning under power pushes along its slip: the
            // wheel's spin speed (from engine rpm) against the ground, and
            // the sideways slide. So power still drives the car in a drift
            // and more wheelspin means less side grip. Never more drive than
            // the engine gives.
            line sx = 0;
            if (throttle > 0 && drive != 0 && global wDrive[line k] > 0 && !(hand > 0 && !line front)) {
                line gr = gearRatio(global cGear[c]);
                line vw = global cRpm[c] / (line gr * 4.1) / 9.549 * global gWheelR;
                if (drive < 0) {
                    line vw = 0 - line vw;
                }
                line sx = line vw - line vlong;
                if (line sx * drive <= 0) {
                    line sx = 0;
                }
            }
            if (line sx != 0) {
                line sl = num.root(line sx * line sx + line vlat * line vlat);
                line fxs = line fm * line sx / line sl;
                if (num.abs(line fxs) < num.abs(line fx)) {
                    line fx = line fxs;
                }
                line fys = 0 - line fm * line vlat / line sl;
                if (num.abs(line fys) < num.abs(line fy)) {
                    line fy = line fys;
                }
            } else {
                line scale = line fm / line mag;
                line fx = line fx * line scale;
                line fy = line fy * line scale;
            }
        }
        // As acceleration (per unit car mass): DF numbers keep 3 decimals, so
        // never multiply by 1 / mass.
        line m = global gMass;
        line fi = line U * (line fs / line m) + line fw * (line fx / line m) + line lat * (line fy / line m);
        global wComp[line k] = line comp;
        global wSlide[line k] = line slide;
        line roll = line vlong / global gWheelR * line dt * 57.3;
        if (line slide == 1 && throttle > 0) {
            line roll += 25 * line sgn;
        }
        if (hand > 0 && !line front) {
            line roll = 0;
        }
        global wSpin[line k] = (global wSpin[line k] + line roll) % 360;
        return [line fi, line r.cross(line fi)];
    }
    global wComp[line k] = 0;
    global wSlide[line k] = 0;
    global wExcess[line k] = 0;
    return [vec(0, 0, 0), vec(0, 0, 0)];
}

/** Puts car c back on its wheels where it is, facing its current heading. */
function carUpright(c: num) {
    line F = global cF[c];
    line flat = vec(line F.x, 0, line F.z);
    if (line flat.len() < 0.1) {
        line flat = vec(0, 0, 1);
    }
    line F = line flat.setLength(1);
    line U = vec(0, 1, 0);
    global cF[c] = line F;
    global cU[c] = line U;
    global cL[c] = line U.cross(line F);
    global cVel[c] = vec(0, 0, 0);
    global cW[c] = vec(0, 0, 0);
    global cPos[c] = global cPos[c] + vec(0, 1.2, 0);
    global cAwake[c] = 60;
    global cGrace[c] = 40;
}

/** Debug (@flip): rolls car c onto its roof, a little above the ground, so
 * it lands upside down. */
function carFlip(c: num) {
    global cU[c] = (global cU[c] as vec) * -1;
    global cL[c] = (global cL[c] as vec) * -1;
    global cVel[c] = vec(0, 0, 0);
    global cW[c] = vec(0, 0, 0);
    global cPos[c] = global cPos[c] + vec(0, 1.5, 0);
    global cAwake[c] = 60;
    global cGrace[c] = 40;
}
