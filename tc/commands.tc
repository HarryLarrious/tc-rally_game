// Chat commands and the join event. Add new commands here: a project has one
// command event.

playerevent join {
    packSend();
    ensureLoop();
    parkSpawn();
    giveRoadbook();
    driverHideAllFrom();
}

playerevent respawn {
    parkSpawn();
    giveRoadbook();
}

/** The service park, looking at the start straight. The plot's own spawn
 * (10, 50, 10) is inside the hills at the map edge. */
function parkSpawn {
    default.teleport(loc(600.5, 51, 955.5, 0, 180));
}

playerevent command {
    line words = event.command.split(" ");
    line cmd = (line words[1] as str).replace("@", "");
    if (tpCommand(line cmd, line words) == 1) {
        return;
    }
    if (line cmd == "car") {
        // @car [turn degrees]: turn 90 shows the car's left side.
        line turn = 0;
        if (line words.len() >= 2) {
            line turn = num.parse(line words[2] as str);
        }
        spawnCarHere(line turn);
    } else if (line cmd == "part") {
        // @part ID [turn]: spawns one part, for checking its model.
        if (line words.len() < 2) {
            default.sendMessage(s"<gray>Usage: <yellow>@part ID [turn]</yellow>");
            return;
        }
        line turn = 0;
        if (line words.len() >= 3) {
            line turn = num.parse(line words[3] as str);
        }
        spawnCarHere(line turn, line words[2] as str);
    } else if (line cmd == "drive") {
        enterNearestCar();
    } else if (line cmd == "exit") {
        exitCar();
    } else if (line cmd == "dkeep") {
        // @dkeep: debug, getting out leaves the driver model in the car.
        driverKeepToggle();
    } else if (line cmd == "hit") {
        hitCommand(line words);
    } else if (line cmd == "damage") {
        damageReport();
    } else if (line cmd == "fix") {
        line c = carNear(default.uuid);
        if (line c == 0) {
            default.sendMessage(s"<gray>No car near you.");
        } else {
            fixCar(line c);
            default.sendMessage(s"<gray>Car %var(c) repaired.");
        }
    } else if (line cmd == "map") {
        mapCommand(line words);
    } else if (line cmd == "start") {
        startCommand();
    } else if (line cmd == "menu") {
        giveRoadbook();
        menuOpen();
    } else if (line cmd == "track") {
        trackCommand(line words);
    } else if (line cmd == "dbg") {
        global dbg = 1 - global dbg;
    } else if (line cmd == "tune") {
        tuneCommand(line words);
    } else if (line cmd == "carcheck") {
        carCheck(global carCount);
    } else if (line cmd == "clearcars") {
        line n = global carCount;
        clearCars();
        default.sendMessage(s"<gray>Removed <yellow>%var(n)</yellow> car(s).");
    } else if (line cmd == "pack") {
        packSend();
    } else {
        default.sendMessage(s"<gray>Commands: <yellow>@menu</yellow>, <yellow>@start</yellow>, <yellow>@car [turn]</yellow>, <yellow>@drive</yellow>, <yellow>@exit</yellow>, <yellow>@fix</yellow>, <yellow>@map build|stop</yellow>, <yellow>@tp/@tpa/@tpr/@tpf/@look/@where</yellow>, <yellow>@spec/@fly/@walk</yellow>, <yellow>@track build|clear</yellow>, <yellow>@damage</yellow>, <yellow>@hit PART AMOUNT</yellow>, <yellow>@tune</yellow>, <yellow>@part ID [turn]</yellow>, <yellow>@carcheck</yellow>, <yellow>@clearcars</yellow>, <yellow>@pack</yellow>.");
    }
}

/** @tune: lists the tunables; @tune NAME VALUE sets one; @tune reset. */
function tuneCommand(words: list) {
    if (words.len() >= 2 && words[2] as str == "reset") {
        resetTuning();
        global linkEvery = 2;
    } else if (words.len() >= 3) {
        line name = words[2] as str;
        line v = num.parse(words[3] as str);
        if (line name == "spring") {
            global tSpring = line v;
        } else if (line name == "damper") {
            global tDamper = line v;
        } else if (line name == "grip") {
            global tGrip = line v;
        } else if (line name == "power") {
            global tPower = line v;
        } else if (line name == "brake") {
            global tBrake = line v;
        } else if (line name == "steer") {
            global tSteer = line v;
        } else if (line name == "lat") {
            global tLatGain = line v;
        } else if (line name == "smooth") {
            global tSmooth = num.clamp(num.floor(line v), 1, 8);
        } else if (line name == "links") {
            global linkEvery = num.max(1, num.floor(line v));
        } else {
            default.sendMessage(s"<red>Unknown tunable.");
            return;
        }
    }
    default.sendMessage(s"<gray>spring <white>%var(tSpring)</white> damper <white>%var(tDamper)</white> grip <white>%var(tGrip)</white> power <white>%var(tPower)</white> brake <white>%var(tBrake)</white> steer <white>%var(tSteer)</white> lat <white>%var(tLatGain)</white> smooth <white>%var(tSmooth)</white> links <white>%var(linkEvery)</white>");
}
