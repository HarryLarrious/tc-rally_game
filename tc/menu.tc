// The menu: a service board in front of the player. Like the dueling game's
// menus, the player sits on a seat while it is open and the screen is a set
// of text displays; here they are a flat board in the world (no shader), so
// the crosshair is the cursor. Look at a button and left click it; right
// click or Shift closes the menu.
//
// Look: dark panels, a rally-yellow header with a red and white curb stripe
// under it, buttons that light up yellow under the crosshair, the chosen
// option in white.
//
// The service board is D blocks ahead of the eye, facing the player. The
// garage (car model, colors, decals, parts) is a second panel hinged to its
// right edge and turned 40 degrees toward the player. Each panel has its
// own frame: coordinates are in blocks from its center, x right, y up. A panel is a
// text display holding one space with a colored background, scaled to size
// (a space's background is 5 x 10 font pixels, 0.025 blocks each, drawn
// from the display's origin up and 0.5 pixel right of center).

/** Open menus: uuid -> {seat, eye (vec), f, r (vec: forward and right),
 * panels (list of {name, c, f, r}: center from the eye, forward and right),
 * the panel being built (pname, pc, pf, pr, pyaw), widgets (list of
 * dicts), hover (button id)}. */
declare global menuOf: dict;

/** Angle a in degrees, wrapped into -180..180. */
function menuWrap(a: num): num {
    return ((a + 180) % 360 + 360) % 360 - 180;
}

/** Distance from the eye to the board. */
function menuDist(): num {
    return 2.0;
}

/** Rally yellow. */
function menuYellow(): str {
    return "#FFC20E";
}

/** World position of point (x, y) of the panel being built, `layer`
 * blocks behind it (negative = in front). */
function menuAt(st: dict, x: num, y: num, layer: num): vec {
    return (st["eye"] as vec) + (st["pc"] as vec) + (st["pf"] as vec) * layer + (st["pr"] as vec) * x + vec(0, y, 0);
}

/** The menu state st with panel `name` added and made the one being
 * built: centered at c (from the eye), facing the player from yaw `yaw`. */
function menuPanel(st: dict, name: str, c: vec, yaw: num): dict {
    line f = vec(0 - num.sin(yaw), 0, num.cos(yaw));
    line r = vec(0 - num.cos(yaw), 0, 0 - num.sin(yaw));
    line s = st;
    line s["pname"] = name;
    line s["pc"] = c;
    line s["pf"] = line f;
    line s["pr"] = line r;
    line s["pyaw"] = yaw;
    line ps = [];
    if (line s.hasKeys("panels")) {
        line ps = line s["panels"] as list;
    }
    line ps.append({name: name, c: c, f: line f, r: line r});
    line s["panels"] = line ps;
    return line s;
}

/** Spawns a display at world point p facing the player; returns its uuid. */
function menuSpawn(st: dict, p: vec, text: txt): str {
    game.spawnTextDisplay(loc(p.x, p.y, p.z), text);
    line ent = lastEntity.uuid;
    // Facing the player: their yaw turned around, kept in -180..180. The
    // spawn location's rotation is not used, so set it here.
    lastEntity.setRotation(0, menuWrap(st["pyaw"] as num + 180));
    lastEntity.setDisplayBillboard(type="Fixed");
    lastEntity.setTextDisplayTextShadow(textShadow="Disable");
    lastEntity.setDisplayBrightness(15, 15);
    lastEntity.setTextDisplayBackground("#000000", 0);
    // Only the player in the menu sees it.
    select !playersByName(default.uuid);
    selected.setEntityHidden([line ent], hidden="Enable");
    select reset;
    return line ent;
}

/** A w x h panel of color (hex) at opacity (%) centered on board (x, y). */
function menuRect(st: dict, x: num, y: num, w: num, h: num, color: str, opacity: num, layer: num): str {
    line sx = w / 0.125;
    line sy = h / 0.25;
    line ent = menuSpawn(st, menuAt(st, x - 0.0125 * line sx, y - h / 2, layer), s" ");
    select entitiesByName(line ent);
    selectedEntity.setTextDisplayBackground(color, opacity);
    selectedEntity.setDisplayScale(line sx, line sy, 1);
    select reset;
    return line ent;
}

/** Styled menu text: style "title" (black, bold), "button" (light, bold),
 * "dark" (black, bold, on a lit button), "label" (yellow, bold), "body"
 * (light gray), "dim" (gray). */
function menuStyle(t: str, style: str): txt {
    if (style == "title" || style == "dark") {
        return s"<black><b>%var(t)</b></black>";
    }
    if (style == "button") {
        return s"<#E8E8E8><b>%var(t)</b></#E8E8E8>";
    }
    if (style == "label") {
        return s"<#FFC20E><b>%var(t)</b></#FFC20E>";
    }
    if (style == "dim") {
        return s"<#8A8F98>%var(t)</#8A8F98>";
    }
    return s"<#D0D3D8>%var(t)</#D0D3D8>";
}

/** Text at scale `size` centered on board (x, y). */
function menuText(st: dict, x: num, y: num, t: str, style: str, size: num): str {
    line ent = menuSpawn(st, menuAt(st, x - 0.0125 * size, y - 0.1375 * size, -0.01), menuStyle(t, style));
    select entitiesByName(line ent);
    selectedEntity.setDisplayScale(size, size, 1);
    selectedEntity.setTextDisplayLineWidth(2000);
    select reset;
    return line ent;
}

/** Board widgets. A button is {kind: "button", id, x, y, w, h, text, size,
 * action, bg, lbl}; a text that changes is {kind: "text", id, ent}. */
function menuButton(st: dict, id: str, x: num, y: num, w: num, h: num, t: str, size: num, action: str): dict {
    line bg = menuRect(st, x, y, w, h, "#2B2F36", 100, 0);
    line lbl = menuText(st, x, y, t, "button", size);
    return {kind: "button", panel: st["pname"], id: id, x: x, y: y, w: w, h: h, text: t, size: size, action: action, bg: line bg, lbl: line lbl};
}

/** A color swatch: a square of `color` in a frame that lights up yellow
 * under the crosshair and white when it is the chosen color. */
function menuSwatch(st: dict, id: str, x: num, y: num, color: str, action: str): dict {
    line frame = menuRect(st, x, y, 0.2, 0.2, "#101215", 100, 0.015);
    line bg = menuRect(st, x, y, 0.14, 0.14, color, 100, 0);
    return {kind: "swatch", panel: st["pname"], id: id, x: x, y: y, w: 0.2, h: 0.2, action: action, bg: line bg, frame: line frame};
}

/** 1 when button id shows a chosen option for the player. */
function menuChosen(id: str): num {
    line manual = gearManual(default.uuid);
    if ((id == "gear_auto" && line manual == 0) || (id == "gear_manual" && line manual == 1)) {
        return 1;
    }
    line slim = driverSlimOf(default.uuid);
    if ((id == "arms_classic" && line slim == 0) || (id == "arms_slim" && line slim == 1)) {
        return 1;
    }
    if (id == "model_hatch") {
        return 1;
    }
    line p = carPaintOf(default.uuid);
    line a = carAccentOf(default.uuid);
    if (id == "paint %var(p)" || id == "accent %var(a)") {
        return 1;
    }
    return 0;
}

/** Colors button w: lit (yellow) under the crosshair, white when chosen,
 * dark otherwise. */
function menuPaint(w: dict, lit: num) {
    line id = w["id"] as str;
    if (w["kind"] as str == "swatch") {
        select entitiesByName(w["frame"] as str);
        if (lit == 1) {
            selectedEntity.setTextDisplayBackground(menuYellow(), 100);
        } else if (menuChosen(line id) == 1) {
            selectedEntity.setTextDisplayBackground("#F2F2F2", 100);
        } else {
            selectedEntity.setTextDisplayBackground("#101215", 100);
        }
        select reset;
        return;
    }
    line t = w["text"] as str;
    select entitiesByName(w["bg"] as str);
    if (lit == 1) {
        selectedEntity.setTextDisplayBackground(menuYellow(), 100);
    } else if (menuChosen(line id) == 1) {
        selectedEntity.setTextDisplayBackground("#E9ECEF", 100);
    } else {
        selectedEntity.setTextDisplayBackground("#2B2F36", 100);
    }
    select reset;
    select entitiesByName(w["lbl"] as str);
    if (lit == 1 || menuChosen(line id) == 1) {
        selectedEntity.setTextDisplayText(menuStyle(line t, "dark"));
    } else {
        selectedEntity.setTextDisplayText(menuStyle(line t, "button"));
    }
    select reset;
}

/** The gearbox note under the gearbox buttons. */
function menuGearNote(): str {
    if (gearManual(default.uuid) == 1) {
        return "Left click shifts up, right click shifts down";
    }
    return "Shifts up near the redline, down when slow";
}

/** Builds the board and the garage for the player; returns the menu state
 * with its panels and widgets. */
function menuBuild(st0: dict): dict {
    line out = [];
    line st = menuPanel(st0, "main", (st0["f"] as vec) * menuDist(), st0["yaw"] as num);
    // Board and header.
    line out.append({kind: "deco", ent: menuRect(line st, 0, 0, 3.2, 2.0, "#101215", 100, 0.03)});
    line out.append({kind: "deco", ent: menuRect(line st, 0, 0.88, 3.2, 0.24, menuYellow(), 100, 0.02)});
    line out.append({kind: "deco", ent: menuText(line st, -0.62, 0.88, "KESTREL RALLY", "title", 0.75)});
    line out.append({kind: "deco", ent: menuText(line st, 1.0, 0.88, "SERVICE BOARD", "title", 0.45)});
    // Curb stripe: red and white blocks under the header. Panels never
    // overlap at the same depth, or one can hide the other from an angle.
    repeat (line i to 20) {
        line col = "#F2F2F2";
        if (line i % 2 == 1) {
            line col = "#D8262E";
        }
        line out.append({kind: "deco", ent: menuRect(line st, -1.6 + 0.08 + (line i - 1) * 0.16, 0.715, 0.16, 0.09, line col, 100, 0.02)});
    }
    // Gearbox.
    line out.append({kind: "deco", ent: menuText(line st, -1.05, 0.5, "GEARBOX", "label", 0.55)});
    line out.append(menuButton(line st, "gear_auto", 0.05, 0.5, 0.8, 0.2, "AUTO", 0.45, "gear auto"));
    line out.append(menuButton(line st, "gear_manual", 0.95, 0.5, 0.8, 0.2, "MANUAL", 0.45, "gear manual"));
    line out.append({kind: "text", id: "gear_note", ent: menuText(line st, 0.45, 0.32, menuGearNote(), "body", 0.34)});
    // The driver model's arms: match the player's skin (Classic 4 px or Slim 3 px).
    line out.append({kind: "deco", ent: menuText(line st, -1.05, 0.12, "ARMS", "label", 0.55)});
    line out.append(menuButton(line st, "arms_classic", 0.05, 0.12, 0.8, 0.2, "CLASSIC", 0.45, "arms classic"));
    line out.append(menuButton(line st, "arms_slim", 0.95, 0.12, 0.8, 0.2, "SLIM", 0.45, "arms slim"));
    // Divider.
    line out.append({kind: "deco", ent: menuRect(line st, 0, 0.0, 2.9, 0.012, "#3A3F47", 100, 0.02)});
    // The stage: the current procedural stage (or the last one played).
    line seed = global gnSeed;
    if (line seed == 0) {
        line seed = saved gnLast;
    }
    line title = "NEW STAGE";
    line sub = "A new stage from a random seed";
    if (line seed > 0) {
        line title = "STAGE #%var(seed)";
        line sub = "No time set yet";
        line best = gnBestText(line seed);
        if (line best != "") {
            line sub = "Best %var(best)";
        }
    }
    line out.append({kind: "deco", ent: menuText(line st, -0.75, -0.2, line title, "label", 0.5)});
    line out.append({kind: "deco", ent: menuText(line st, -0.75, -0.38, line sub, "body", 0.36)});
    line out.append(menuButton(line st, "start", 0.95, -0.17, 1.0, 0.2, "DRIVE STAGE", 0.42, "start"));
    line out.append(menuButton(line st, "new", 0.95, -0.41, 1.0, 0.2, "NEW STAGE", 0.42, "new"));
    // Bottom row and hint.
    line out.append(menuButton(line st, "car", -0.95, -0.66, 1.0, 0.22, "SPAWN CAR", 0.42, "car"));
    line out.append(menuButton(line st, "close", 0.95, -0.66, 1.0, 0.22, "CLOSE", 0.42, "close"));
    line out.append({kind: "deco", ent: menuText(line st, 0, -0.9, "Look to aim, left click picks, right click or Shift closes. Garage on the right", "dim", 0.3)});
    // The garage: hinged to the board's right edge (x 1.6), turned 40
    // degrees toward the player.
    line yaw2 = (line st["yaw"] as num) + 40;
    line r2 = vec(0 - num.cos(line yaw2), 0, 0 - num.sin(line yaw2));
    line st = menuPanel(line st, "garage", (line st["f"] as vec) * menuDist() + (line st["r"] as vec) * 1.68 + line r2 * 1.1, line yaw2);
    for (line w of menuGarage(line st)) {
        line out.append(line w);
    }
    for (line w of line out) {
        line kind = (line w as dict)["kind"] as str;
        if (line kind == "button" || line kind == "swatch") {
            menuPaint(line w as dict, 0);
        }
    }
    line st["widgets"] = line out;
    return line st;
}

/** The garage panel (st has it as the panel being built, 2.2 wide): car
 * model, primary and secondary colors with a livery preview, decals and
 * parts (coming). */
function menuGarage(st: dict): list {
    line out = [];
    line w = 2.2;
    line out.append({kind: "deco", ent: menuRect(st, 0, 0, line w, 2.0, "#101215", 100, 0.03)});
    line out.append({kind: "deco", ent: menuRect(st, 0, 0.88, line w, 0.24, menuYellow(), 100, 0.02)});
    line out.append({kind: "deco", ent: menuText(st, -0.45, 0.88, "GARAGE", "title", 0.75)});
    line out.append({kind: "deco", ent: menuText(st, 0.62, 0.88, "YOUR CAR", "title", 0.45)});
    repeat (line i to 14) {
        line col = "#F2F2F2";
        if (line i % 2 == 1) {
            line col = "#D8262E";
        }
        line out.append({kind: "deco", ent: menuRect(st, 0 - line w / 2 + (line w / 14) * (line i - 0.5), 0.715, line w / 14, 0.09, line col, 100, 0.02)});
    }
    // Model: one car for now; more get buttons here.
    line out.append({kind: "deco", ent: menuText(st, -0.72, 0.5, "MODEL", "label", 0.45)});
    line out.append(menuButton(st, "model_hatch", 0.42, 0.5, 1.2, 0.18, "RALLY HATCHBACK", 0.38, "model hatch"));
    // Colors.
    line hexes = carColorHexes();
    line out.append({kind: "deco", ent: menuText(st, -0.72, 0.27, "PRIMARY", "label", 0.45)});
    line out.append({kind: "deco", ent: menuText(st, -0.72, 0.05, "SECONDARY", "label", 0.45)});
    repeat (line i to line hexes.len()) {
        line x = -0.26 + (line i - 1) * 0.18;
        line out.append(menuSwatch(st, "paint %var(i)", line x, 0.27, line hexes[line i] as str, "paint %var(i)"));
        line out.append(menuSwatch(st, "accent %var(i)", line x, 0.05, line hexes[line i] as str, "accent %var(i)"));
    }
    // Livery preview: body color with an accent stripe.
    line out.append({kind: "deco", ent: menuText(st, -0.72, -0.17, "LIVERY", "label", 0.45)});
    line pc = line hexes[carPaintOf(default.uuid)] as str;
    line ac = line hexes[carAccentOf(default.uuid)] as str;
    line out.append({kind: "preview", id: "prev_paint", ent: menuRect(st, 0.37, -0.17, 1.26, 0.2, line pc, 100, 0.01)});
    line out.append({kind: "preview", id: "prev_accent", ent: menuRect(st, 0.37, -0.17, 1.26, 0.05, line ac, 100, 0)});
    line out.append({kind: "deco", ent: menuRect(st, 0, -0.33, line w - 0.3, 0.012, "#3A3F47", 100, 0.02)});
    // Coming: decals and parts.
    line out.append({kind: "deco", ent: menuText(st, -0.72, -0.48, "DECALS", "label", 0.45)});
    line out.append({kind: "deco", ent: menuText(st, 0.37, -0.48, "Coming soon", "dim", 0.36)});
    line out.append({kind: "deco", ent: menuText(st, -0.72, -0.68, "PARTS", "label", 0.45)});
    line out.append({kind: "deco", ent: menuText(st, 0.37, -0.68, "Coming soon", "dim", 0.36)});
    line out.append({kind: "deco", ent: menuText(st, 0, -0.9, "Colors apply to the cars you spawn", "dim", 0.3)});
    return line out;
}

/** 1 while the player has the menu open. */
function menuIsOpen(uuid: str): num {
    if (global menuOf.hasKeys(uuid)) {
        return 1;
    }
    return 0;
}

/** Opens the menu for the player (not while driving). */
function menuOpen {
    line uuid = default.uuid;
    if (menuIsOpen(line uuid) == 1) {
        return;
    }
    if (carOf(line uuid) != 0) {
        default.sendMessage(s"<gray>Get out of the car (<yellow>F</yellow>) to open the menu.");
        return;
    }
    line me = default.location;
    // Minecraft yaw is not wrapped (it can be 400 or -900).
    line yaw = menuWrap(line me.getCoordinate(coord="Yaw"));
    game.spawnInteractionEntity(loc(line me.x, line me.y, line me.z), 0.6, 0.6);
    line seat = lastEntity.uuid;
    default.rideEntity(line seat);
    default.setRotation(0, line yaw);
    default.setHotbarSlot(1);
    // Let the riding pose settle before reading the eye position.
    wait(2);
    line eye = default.eyeLocation;
    line st = {
        seat: line seat,
        yaw: line yaw,
        eye: vec(line eye.x, line eye.y, line eye.z),
        f: vec(0 - num.sin(line yaw), 0, num.cos(line yaw)),
        r: vec(0 - num.cos(line yaw), 0, 0 - num.sin(line yaw)),
        hover: ""
    };
    line st = menuBuild(line st);
    global menuOf[line uuid] = line st;
    start menuLoop;
}

/** Closes the player's menu: removes the board and the seat. */
function menuClose {
    line uuid = default.uuid;
    if (menuIsOpen(line uuid) == 0) {
        return;
    }
    line st = global menuOf[line uuid] as dict;
    global menuOf.remove(line uuid);
    for (line wv of line st["widgets"] as list) {
        line w = line wv as dict;
        for (line key of ["ent", "bg", "lbl", "frame"]) {
            if (line w.hasKeys(line key as str)) {
                select entitiesByName(line w[line key as str] as str);
                selectedEntity.remove();
                select reset;
            }
        }
    }
    default.rideEntity();
    select entitiesByName(line st["seat"] as str);
    selectedEntity.remove();
    select reset;
}

/** Id of the button under the crosshair, or "". */
function menuHit(st: dict): str {
    line view = default.location;
    line yaw: num = line view.getCoordinate(coord="Yaw");
    line pitch: num = line view.getCoordinate(coord="Pitch");
    line d = vec(0 - num.sin(line yaw) * num.cos(line pitch), 0 - num.sin(line pitch), num.cos(line yaw) * num.cos(line pitch));
    // The look ray against each panel's plane, then its buttons.
    for (line pv of st["panels"] as list) {
        line p = line pv as dict;
        line pf = line p["f"] as vec;
        line pc = line p["c"] as vec;
        line along = line d.dot(line pf);
        if (line along > 0.2) {
            line hit = line d * (line pc.dot(line pf) / line along) - line pc;
            line x = line hit.dot(line p["r"] as vec);
            line y = line hit.y;
            for (line wv of st["widgets"] as list) {
                line w = line wv as dict;
                line kind = line w["kind"] as str;
                if ((line kind == "button" || line kind == "swatch") && line w["panel"] as str == line p["name"] as str) {
                    if (num.abs(line x - (line w["x"] as num)) <= (line w["w"] as num) / 2 && num.abs(line y - (line w["y"] as num)) <= (line w["h"] as num) / 2) {
                        return line w["id"] as str;
                    }
                }
            }
        }
    }
    return "";
}

/** Relights buttons when the one under the crosshair changes. */
function menuHoverTick {
    line uuid = default.uuid;
    line st = global menuOf[line uuid] as dict;
    line now = menuHit(line st);
    line was = line st["hover"] as str;
    if (line now == line was) {
        return;
    }
    for (line wv of line st["widgets"] as list) {
        line w = line wv as dict;
        if (line w["kind"] as str == "button" || line w["kind"] as str == "swatch") {
            line id = line w["id"] as str;
            if (line id == line now) {
                menuPaint(line w, 1);
            } else if (line id == line was) {
                menuPaint(line w, 0);
            }
        }
    }
    line st["hover"] = line now;
    global menuOf[line uuid] = line st;
}

process menuLoop {
    repeat {
        if (menuIsOpen(default.uuid) == 0) {
            break;
        }
        menuHoverTick();
        wait;
    }
}

/** Left click in the menu: runs the button under the crosshair. */
function menuClick {
    line uuid = default.uuid;
    line st = global menuOf[line uuid] as dict;
    line hit = menuHit(line st);
    for (line wv of line st["widgets"] as list) {
        line w = line wv as dict;
        if ((line w["kind"] as str == "button" || line w["kind"] as str == "swatch") && line w["id"] as str == line hit) {
            menuAction(line w["action"] as str);
            return;
        }
    }
}

/** Runs a menu action for the player. */
function menuAction(action: str) {
    line uuid = default.uuid;
    line words = action.split(" ");
    if (line words[1] as str == "paint" || line words[1] as str == "accent") {
        line i = num.parse(line words[2] as str);
        if (line words[1] as str == "paint") {
            saved carPaintSel[line uuid] = line i;
        } else {
            saved carAccentSel[line uuid] = line i;
        }
        default.playSound(snd("UI Button Click"));
        menuRepaint();
        return;
    }
    if (action == "model hatch") {
        default.playSound(snd("UI Button Click"));
        return;
    }
    if (action == "arms classic" || action == "arms slim") {
        if (action == "arms slim") {
            saved driverSlim[line uuid] = 1;
        } else {
            saved driverSlim[line uuid] = 0;
        }
        default.playSound(snd("UI Button Click"));
        line st = global menuOf[line uuid] as dict;
        for (line wv of line st["widgets"] as list) {
            line w = line wv as dict;
            if (line w["kind"] as str == "button") {
                if (line w["id"] as str == line st["hover"] as str) {
                    menuPaint(line w, 1);
                } else {
                    menuPaint(line w, 0);
                }
            }
        }
    } else if (action == "gear auto" || action == "gear manual") {
        if (action == "gear manual") {
            saved gearMode[line uuid] = 1;
        } else {
            saved gearMode[line uuid] = 0;
        }
        default.playSound(snd("UI Button Click"));
        line st = global menuOf[line uuid] as dict;
        for (line wv of line st["widgets"] as list) {
            line w = line wv as dict;
            if (line w["kind"] as str == "button") {
                if (line w["id"] as str == line st["hover"] as str) {
                    menuPaint(line w, 1);
                } else {
                    menuPaint(line w, 0);
                }
            }
        }
        // The note under the gearbox buttons.
        for (line wv of line st["widgets"] as list) {
            line w = line wv as dict;
            if (line w["kind"] as str == "text") {
                select entitiesByName(line w["ent"] as str);
                selectedEntity.setTextDisplayText(menuStyle(menuGearNote(), "body"));
                select reset;
            }
        }
    } else if (action == "start") {
        menuClose();
        startCommand();
    } else if (action == "new") {
        menuClose();
        startCommand("new");
    } else if (action == "car") {
        menuClose();
        spawnCarHere(0);
    } else if (action == "close") {
        menuClose();
    }
}

/** Repaints the open menu's buttons and swatches and the livery preview
 * after a choice changed. */
function menuRepaint {
    line uuid = default.uuid;
    line st = global menuOf[line uuid] as dict;
    line hexes = carColorHexes();
    for (line wv of line st["widgets"] as list) {
        line w = line wv as dict;
        line kind = line w["kind"] as str;
        if (line kind == "button" || line kind == "swatch") {
            if (line w["id"] as str == line st["hover"] as str) {
                menuPaint(line w, 1);
            } else {
                menuPaint(line w, 0);
            }
        } else if (line kind == "preview") {
            line col = line hexes[carAccentOf(line uuid)] as str;
            if (line w["id"] as str == "prev_paint") {
                line col = line hexes[carPaintOf(line uuid)] as str;
            }
            select entitiesByName(line w["ent"] as str);
            selectedEntity.setTextDisplayBackground(line col, 100);
            select reset;
        }
    }
}

/** The roadbook in hotbar slot 1: right click it to open the menu. Holding
 * an item also makes right clicks reach the plot (the manual gearbox). */
function giveRoadbook {
    line book = item("paper").setName(s"<#FFC20E><b>Roadbook</b></#FFC20E> <gray>(right click)");
    // Driving: the same book, drawn as nothing (the driver model holds the wheel).
    if (carOf(default.uuid) != 0) {
        line book = driverHandItem();
    }
    default.setItemInSlot(line book, 1);
    default.setHotbarSlot(1);
}

playerevent leftClick {
    if (menuIsOpen(default.uuid) == 1) {
        menuClick();
    } else if (carOf(default.uuid) != 0) {
        shiftGear(1);
    }
}

playerevent rightClick {
    if (menuIsOpen(default.uuid) == 1) {
        menuClose();
    } else if (carOf(default.uuid) != 0) {
        shiftGear(-1);
    } else {
        menuOpen();
    }
}

playerevent changeSlot {
    // Keep the roadbook in hand while driving and in the menu, so right
    // clicks keep reaching the plot.
    if (menuIsOpen(default.uuid) == 1 || carOf(default.uuid) != 0) {
        default.setHotbarSlot(1);
    }
}
