// Engine sound (pack/src/engine_sound.py): one short clip of whole
// firing cycles (inline-4, or the hypercar's V8), played every tick at the engine and pitched to the
// exact rpm. Consecutive clips overlap, so the pitch follows the rpm in small
// steps. The cycle is baked at three base speeds so no clip is pitched more
// than about +-45% (pitching further drags the exhaust tone up and sounds
// buzzy): engine.lo (1300 rpm, 2 cycles), engine.mid (2900 rpm, 5 cycles),
// engine.hi (5800 rpm, 10 cycles), crossfaded around 1900 and 4100 rpm. Off
// throttle the engine is quieter and pops now and then above 3500 rpm.

/** Plays car c's engine for this tick. A dead engine is silent; with the
 * exhaust torn off it is louder. The hypercar plays the V8 clips, its turbo
 * whistle (pitched and turned up with the boost) and the blow-off valve
 * when the boost is dumped; its overrun pops are deeper and spit flames
 * from the twin tail pipes. */
function engineSound(c: num) {
    if (global cPower[c] <= 0) {
        return;
    }
    line v8 = global cModel[c] == 2;
    line pre = "";
    if (line v8) {
        line pre = "v8_";
    }
    line rpm = global cRpm[c];
    line at = partWorld(c, global iEngine);
    line gain = 1;
    if (global cThr[c] == 0) {
        line gain = 0.45;
        if (line rpm > 3500 && num.randomd(0, 1) < 0.08) {
            allPlayers.playSound(csnd("rally:engine.%var(pre)pop", num.randomd(0.85, 1.15), 0.8), line at);
            if (line v8) {
                for (line s of [1, -1]) {
                    allPlayers.displayParticleEffect(par("Flame"), carPoint(c, vec(0.22 * (line s as num), 0.34, -2.12)));
                }
            }
        }
    }
    if (partHealth(c, global iExhaust) <= 0) {
        line gain = line gain * 1.5;
    }
    if (line v8) {
        line boost = global cBoost[c];
        if (line boost > 0.05) {
            allPlayers.playSound(csnd("rally:engine.turbo", 0.85 + line boost * 0.4, line boost * 0.07), line at);
        }
        if (global cBov[c] == 1) {
            global cBov[c] = 0;
            allPlayers.playSound(csnd("rally:engine.bov", num.randomd(0.95, 1.08), 0.45), line at);
        }
    }
    // Crossfade lo -> mid around 1900 rpm and mid -> hi around 4100 rpm.
    line up1 = num.clamp((line rpm - 1700) / 400, 0, 1);
    line up2 = num.clamp((line rpm - 3900) / 400, 0, 1);
    if (line up1 < 1) {
        engineClip("%var(pre)lo", 1300, 2, line rpm, line at, line gain * (1 - line up1));
    }
    if (line up1 > 0 && line up2 < 1) {
        engineClip("%var(pre)mid", 2900, 5, line rpm, line at, line gain * line up1 * (1 - line up2));
    }
    if (line up2 > 0) {
        engineClip("%var(pre)hi", 5800, 10, line rpm, line at, line gain * line up2);
    }
}

/** World location of point v (car frame) of car c. */
function carPoint(c: num, v: vec): loc {
    line p = v - carCom();
    line w = global cPos[c] + global cL[c] * line p.x + global cU[c] * line p.y + global cF[c] * line p.z;
    return loc(line w.x, line w.y, line w.z);
}

/** Plays engine clip `name` (baked at `base` rpm, `cycles` engine cycles
 * long) pitched to `rpm`. Its volume allows for how many copies of it
 * overlap at that pitch, so the sum stays about as loud at any rpm. */
function engineClip(name: str, base: num, cycles: num, rpm: num, at: loc, gain: num) {
    line pitch = num.clamp(rpm / base, 0.5, 2);
    // Copies alive at once: clip length (cycles * 120 / base s) / pitch / 0.05 s.
    line overlap = cycles * 2400 / base / line pitch;
    line vol = num.min(1, 0.75 / num.root(line overlap * 0.375)) * gain;
    allPlayers.playSound(csnd("rally:engine." + name, line pitch, line vol), at);
}
