// Cars: state, spawning and removing.
//
// A car is one rigid body (physics.tc) drawn by carPartCount() item displays
// (render.tc). All displays stand on the car origin (on the ground between
// the axles, in the car frame) and are teleported there every tick. "Rigid"
// parts are modeled around that origin and all share the car's rotation
// matrix; wheels, uprights, arms, springs, half shafts and the steering wheel
// get their own matrix. The driver rides an interaction-entity seat
// (drive.tc).
//
// Car frame: +X left, +Y up, +Z forward, meters. A car's orientation is its
// left (cL), up (cU) and forward (cF) unit vectors in world space.

/** Display UUIDs of each car: every part, the rigid ones, and the movers in
 * mover order (per corner 1..4: wheel, upright, arm, spring, half shaft;
 * then the steering wheel). */
declare global cAll: list;
declare global cRigid: list;
declare global cMove: list;
/** Display UUIDs still on each car (teleported with it every tick). */
declare global cTp: list;
/** Seat entity UUID and driver UUID ("" when empty). */
declare global cSeat: list[str];
declare global cDriver: list[str];
/** Body state: center of mass position and velocity, angular velocity
 * (world, rad/s), and the frame vectors. */
declare global cPos: list[vec];
declare global cVel: list[vec];
declare global cW: list[vec];
declare global cL: list[vec];
declare global cU: list[vec];
declare global cF: list[vec];
/** Front wheel angle (degrees, + = left), gear (-1 reverse, 1..6), engine
 * rpm, ticks until a gear change finishes, and the last tick the handbrake
 * was held. */
declare global cSteer: list[num];
declare global cGear: list[num];
declare global cRpm: list[num];
declare global cShift: list[num];
declare global cHand: list[num];
/** Ticks the car keeps simulating without a driver; 1 = a debug part spawn
 * that never simulates. */
declare global cAwake: list[num];
declare global cStatic: list[num];
/** Strongest impact speed (m/s) this tick, for sound and later damage. */
declare global cImpact: list[num];
/** Ticks left in which hits and bottoming out do no damage (after spawning,
 * repairing or putting the car back on its wheels). */
declare global cGrace: list[num];
/** Per wheel, 4 per car (car c, corner i at (c - 1) * 4 + i): suspension
 * compression (m), roll angle (degrees), surface grip, and 1 when the tire
 * is sliding. */
declare global wComp: list[num];
declare global wSpin: list[num];
declare global wMu: list[num];
declare global wSlide: list[num];
/** Number of cars. */
declare global carCount: num;

/** Body paint colors cycled through by new cars. */
function carPaints(): list {
    return [0xD8D8D8, 0xC81E1E, 0x1E5AA8, 0xF0B429, 0x2E8B3A, 0x202124];
}

/** Accent colors, paired with carPaints by index. */
function carAccents(): list {
    return [0x1E5AA8, 0xF0F0F0, 0xF0B429, 0x202124, 0xF0F0F0, 0xC81E1E];
}

/** Center of mass in the car frame. */
function carCom(): vec {
    return vec(0, 0.5, 0.05);
}

/** Index of a mover in cMove: corner 1..4 and kind, or 21 for the steering
 * wheel. */
function moverIndex(kind: str, corner: num): num {
    if (kind == "steer") {
        return 21;
    }
    line k = ["wheel", "upright", "arm", "spring", "halfshaft"].find(kind);
    return (corner - 1) * 5 + line k;
}

/** Spawns a car with its origin at `at`, facing at's yaw, painted with the
 * paint and accent colors. With `only` set to a part id, spawns just that
 * part and never simulates it (for checking models). Returns the car's
 * number. */
function spawnCar(at: loc, paint: num, accent: num, only: str = ""): num {
    line yaw: num = at.getCoordinate(coord="Yaw");
    line origin = loc(at.x, at.y, at.z, 0, 0);
    line fwd = vec(0 - num.sin(line yaw), 0, num.cos(line yaw));
    line up = vec(0, 1, 0);
    line left = line up.cross(line fwd);

    global carCount += 1;
    line sets = spawnDisplays(line origin, paint, accent, only);
    global cAll.append(line sets[1]);
    global cRigid.append(line sets[2]);
    global cMove.append(line sets[3]);
    global cTp.append(liveIds(line sets[1] as list));

    // The seat: an interaction entity the driver rides (drive.tc moves it).
    game.spawnInteractionEntity(line origin, 0.01, 0.01);
    global cSeat.append(lastEntity.uuid);
    global cDriver.append("");

    line com = carCom();
    global cPos.append(vec(at.x, at.y + 0.1, at.z) + line left * line com.x + line up * line com.y + line fwd * line com.z);
    global cVel.append(vec(0, 0, 0));
    global cW.append(vec(0, 0, 0));
    global cL.append(line left);
    global cU.append(line up);
    global cF.append(line fwd);
    global cSteer.append(0);
    global cGear.append(1);
    global cRpm.append(900);
    global cShift.append(0);
    global cHand.append(-10);
    global cAwake.append(60);
    global cImpact.append(0);
    global cGrace.append(40);
    if (only != "") {
        global cStatic.append(1);
    } else {
        global cStatic.append(0);
    }
    repeat (line i to 4) {
        global wComp.append(0);
        global wSpin.append(0);
        global wMu.append(0.9);
        global wSlide.append(0);
    }
    if (global gParts == 0) {
        loadCarGeom();
        loadPartStats();
    }
    carInitDamage(global carCount, paint, accent);
    if (only == "") {
        carRender(global carCount);
    }
    return global carCount;
}

/** The non-empty UUIDs of `ids`. */
function liveIds(ids: list): list {
    line out = [];
    for (line id of ids) {
        if (line id as str != "") {
            line out.append(line id);
        }
    }
    return line out;
}

/** Removes the displays in `ids`, skipping empty entries. */
function removeDisplays(ids: list) {
    for (line id of ids) {
        if (line id as str != "") {
            select entitiesByName(line id as str);
            selectedEntity.remove();
            select reset;
        }
    }
}

/** Spawns one car's part displays at `origin` (only part `only` when set):
 * [every display in carPartData order, the rigid ones, the movers in mover
 * order]. With `only` set, the other entries of the first list are "". */
function spawnDisplays(origin: loc, paint: num, accent: num, only: str): list {
    line all = [];
    line rigid = [];
    line move = ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""];
    for (line row of carPartData()) {
        line p = (line row as str).split(" ");
        if (only != "" && line p[1] as str != only) {
            line all.append("");
            continue;
        }
        line look = item("stone").setModel(line p[2] as str).setModelDataNumbers(paint, accent, type="Colors");
        game.spawnItemDisplay(origin, line look);
        lastEntity.setDisplayTeleportDuration(1);
        // Full brightness: the displays stand on the car origin at ground
        // level, where the light DF samples would be 0.
        lastEntity.setDisplayBrightness(15, 15);
        line id = lastEntity.uuid;
        line all.append(line id);
        if (line p[3] as str == "rigid") {
            line rigid.append(line id);
        } else {
            line move[moverIndex(line p[3] as str, num.parse(line p[4] as str))] = line id;
        }
    }
    return [line all, line rigid, line move];
}

/** Messages the player which parts of car c have no display in the world. */
function carCheck(c: num) {
    line missing = 0;
    for (line id of global cAll[c] as list) {
        select entitiesByName(line id as str);
        if (!selectedEntity.exists()) {
            line missing += 1;
        }
        select reset;
    }
    line n = (global cAll[c] as list).len();
    default.sendMessage(s"<gray>Car %var(c): %var(missing) of %var(n) displays missing.");
}

/** Forgets cars whose displays are gone (a mode switch removes plot
 * entities but keeps the globals). */
function dropStaleCars {
    if (global carCount == 0) {
        return;
    }
    select entitiesByName(global cSeat[1]);
    if (!selectedEntity.exists()) {
        select reset;
        clearCars();
        return;
    }
    select reset;
}

/** Removes every car (drivers get out first) and empties the car lists. */
function clearCars {
    repeat (line c to global carCount) {
        if (global cDriver[line c] != "") {
            select playersByName(global cDriver[line c]);
            selected.rideEntity();
            select reset;
        }
        removeDisplays(global cAll[line c] as list);
        select entitiesByName(global cSeat[line c]);
        selectedEntity.remove();
        select reset;
    }
    clearDebris(0);
    global pHp = [];
    global pOff = [];
    global pLook = [];
    global cPaint = [];
    global cAccent = [];
    global cPower = [];
    global cGearMax = [];
    global cOverheat = [];
    global wDrive = [];
    global wSpringF = [];
    global wGripF = [];
    global wGone = [];
    global cAll = [];
    global cTp = [];
    global cRigid = [];
    global cMove = [];
    global cSeat = [];
    global cDriver = [];
    global cPos = [];
    global cVel = [];
    global cW = [];
    global cL = [];
    global cU = [];
    global cF = [];
    global cSteer = [];
    global cGear = [];
    global cRpm = [];
    global cShift = [];
    global cHand = [];
    global cAwake = [];
    global cStatic = [];
    global cImpact = [];
    global cGrace = [];
    global wComp = [];
    global wSpin = [];
    global wMu = [];
    global wSlide = [];
    global carCount = 0;
}

/** Spawns a car 6 blocks in front of the player on their feet level, facing
 * the way they look turned by `turn` degrees, with the next paint scheme.
 * With `only` set to a part id, spawns just that part. */
function spawnCarHere(turn: num = 0, only: str = "") {
    ensureLoop();
    line feet = default.location;
    line yaw: num = line feet.getCoordinate(coord="Yaw");
    line at = loc(line feet.x, line feet.y, line feet.z, 0, line yaw);
    line at = line at.shiftInDirection(6, direction="Forward");
    line at = loc(line at.x, line at.y, line at.z, 0, line yaw + turn);
    line k = global carCount % carPaints().len() + 1;
    line c = spawnCar(line at, carPaints()[line k] as num, carAccents()[line k] as num, only);
    default.sendMessage(s"<gray>Car <yellow>%var(c)</yellow> spawned. <yellow>@drive</yellow> to get in.");
}
